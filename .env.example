DATABASE_URL=sqlite:///./data/receipt_iq.db
STORAGE_DIR=./data/uploads
# JSON allowlist shared by CORS and CSRF origin validation.
# Production: replace with only your exact HTTPS frontend origin(s).
FRONTEND_ORIGINS=["http://localhost:5173","http://127.0.0.1:5173","http://localhost:5174","http://127.0.0.1:5174"]
COOKIE_SECURE=false
SESSION_HOURS=24
