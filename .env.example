DATABASE_URL=sqlite:///./data/receipt_iq.db
STORAGE_DIR=./data/uploads
# JSON allowlist shared by CORS and CSRF origin validation.
# Production: replace with only your exact HTTPS frontend origin(s).
FRONTEND_ORIGINS=["http://localhost:5173","http://127.0.0.1:5173","http://localhost:5174","http://127.0.0.1:5174"]
COOKIE_SECURE=false
SESSION_HOURS=24
# Free cloud hosting: PostgreSQL plus a PRIVATE Supabase Storage bucket.
STORAGE_BACKEND=local
SERVE_FRONTEND=false
# SUPABASE_URL=https://PROJECT.supabase.co
# SUPABASE_SECRET_KEY=server-only-secret-set-in-host-dashboard
# SUPABASE_BUCKET=receipts
# Windows example after installing Tesseract:
# TESSERACT_CMD=C:/Program Files/Tesseract-OCR/tesseract.exe
